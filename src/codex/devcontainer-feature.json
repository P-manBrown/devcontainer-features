{
  "id": "codex",
  "version": "2.0.0",
  "name": "Codex",
  "documentationURL": "https://github.com/P-manBrown/devcontainer-features/tree/main/src/codex",
  "licenseURL": "https://github.com/P-manBrown/devcontainer-features/blob/main/LICENSE",
  "description": "Install the official Codex CLI. Relaxes the container's seccomp/AppArmor profiles and adds SYS_ADMIN so Codex's bubblewrap-based Linux sandbox can create the user namespace it needs.",
  "options": {
    "version": {
      "type": "string",
      "proposals": ["latest"],
      "default": "latest",
      "description": "Enter a Codex version, or use 'latest'."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt"]
    }
  },
  "mounts": [
    {
      "source": "codex-config-${devcontainerId}",
      "target": "/usr/local/share/codex-config",
      "type": "volume"
    }
  ],
  "securityOpt": ["seccomp=unconfined", "apparmor=unconfined"],
  "capAdd": ["SYS_ADMIN"],
  "entrypoint": "/usr/local/share/codex-init.sh",
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/P-manBrown/devcontainer-features/common-utils",
    "ghcr.io/devcontainers/features/git",
    "ghcr.io/P-manBrown/devcontainer-features/git-from-src-fast"
  ]
}
